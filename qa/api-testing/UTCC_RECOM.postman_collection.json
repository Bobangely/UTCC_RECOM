                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));",
                  "pm.test('Response time is below 5000ms', () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Nearby page returns 200",
          "request": {
