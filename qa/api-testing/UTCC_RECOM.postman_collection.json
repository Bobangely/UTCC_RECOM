        },
        {
          "name": "Get nearby categories",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/nearby-categories" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
